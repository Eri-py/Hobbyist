{
  "name": "@hobbyist/types",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts"
    }
  },
  "scripts": {
    "generate-types": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 openapi-typescript https://localhost:7000/openapi/v1.json -o src/types.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf node_modules"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3"
  }
}
