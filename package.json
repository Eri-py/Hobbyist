{
  "name": "hobbyist",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "resolutions": {
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "zod": "3.25.76"
  },
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom": "0.8.13",
      "brace-expansion": ">=5.0.6",
      "flatted": ">=3.4.2",
      "minimatch": "10.2.5",
      "node-forge": ">=1.4.0",
      "picomatch": ">=4.0.4",
      "seroval": ">=1.5.4",
      "undici": "7.28.0",
      "yaml": ">=2.9.0"
    }
  },
  "scripts": {
    "lint": "pnpm --recursive lint",
    "lint:fix": "pnpm --recursive lint:fix",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --recursive test",
    "generate-types": "pnpm --filter @hobbyist/types generate-types",
    "generate-feature-flags": "node Scripts/generate-feature-flags.js",
    "clean": "node Scripts/clean.js",
    "reset": "pnpm clean && pnpm install"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "rimraf": "^6.1.3",
    "typescript": "~5.9.3"
  },
  "packageManager": "pnpm@10.34.5"
}
