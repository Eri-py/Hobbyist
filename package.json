{
  "name": "hobbyist",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "resolutions": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "3.25.76"
  },
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom": ">=0.8.12",
      "brace-expansion": ">=5.0.5",
      "flatted": ">=3.4.2",
      "minimatch": "10.2.5",
      "node-forge": ">=1.4.0",
      "picomatch": ">=4.0.4",
      "seroval": ">=1.4.1",
      "undici": ">=7.24.6",
      "yaml": ">=2.8.3"
    }
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./Website\" --filter \"./Mobile\" dev",
    "dev:web": "pnpm --filter website dev",
    "dev:mobile": "pnpm --filter mobile dev",
    "build": "pnpm --recursive --filter \"./Website\" --filter \"./Mobile\" build",
    "build:web": "pnpm --filter website build",
    "build:mobile": "pnpm --filter mobile build",
    "lint": "pnpm --recursive lint",
    "lint:fix": "pnpm --recursive lint:fix",
    "typecheck": "pnpm --recursive typecheck",
    "test": "pnpm --recursive test",
    "generate-types": "pnpm --filter @hobbyist/types generate-types",
    "generate-feature-flags": "node Scripts/generate-feature-flags.js",
    "clean": "node Scripts/clean.js",
    "reset": "pnpm clean && pnpm install"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.3",
    "rimraf": "^6.1.3",
    "typescript": "~5.9.3"
  },
  "packageManager": "pnpm@10.33.0"
}
