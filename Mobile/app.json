{
  "expo": {
    "name": "Hobbyist",
    "slug": "hobbyist",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "hobbyist",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hobbyist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 150,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "expo-image"
    ],
    "extra": {
      "eas": {
        "projectId": "50597242-ae48-457a-9b0a-609863e0ba42"
      }
    },
    "owner": "lefti"
  }
}
