{
  "expo": {
    "name": "Hobbyist",
    "slug": "hobbyist",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "hobbyist",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hobbyist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 150,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Hobbyist to access your camera.",
          "microphonePermission": "Allow Hobbyist to access your microphone."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Hobbyist to access your photos.",
          "savePhotosPermission": "Allow Hobbyist to save photos.",
          "isAccessMediaLocationEnabled": true
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a8d6c299-e66a-4ccc-88eb-8cf97a4d0665"
      }
    }
  }
}
