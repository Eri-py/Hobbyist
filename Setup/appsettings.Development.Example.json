{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Development": "your-sql-database-connection-string"
  },
  "ClientOrigin": {
    "Name": "Development",
    "Address": "https://your-machine-name.tail123456.ts.net:3000"
  },
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://0.0.0.0:7000",
        "Certificate": {
          "Path": "../../certs/your-machine-name.tail123456.ts.net.crt",
          "KeyPath": "../../certs/your-machine-name.tail123456.ts.net.key"
        }
      }
    }
  },
  "Jwt": {
    "Secret": "your-super-secure-jwt-secret-key-here-minimum-32-characters",
    "Issuer": "hobbyist-api",
    "Audience": "hobbyist-client"
  },
  "Mailtrap": {
    "Host": "sandbox.smtp.mailtrap.io",
    "Port": "2525",
    "Username": "your-mailtrap-username",
    "Password": "your-mailtrap-password",
    "FromName": "Hobbyist Team",
    "FromAddress": "noreply@hobbyist.com"
  }
}
