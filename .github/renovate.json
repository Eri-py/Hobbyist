{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "dependencyDashboard": true,
  "prConcurrentLimit": 10,
  "schedule": ["before 6am on monday"],
  "rangeStrategy": "bump",
  "ignoreDeps": ["zod"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "Disable Expo/React Native ecosystem updates in Mobile package",
      "matchManagers": ["npm"],
      "matchFileNames": ["Mobile/package.json"],
      "matchPackageNames": [
        "react-native",
        "expo{/,}**",
        "@expo/{/,}**",
        "react-native{/,}**",
        "@react-native/{/,}**",
        "@react-navigation/{/,}**"
      ],
      "enabled": false
    },
    {
      "description": "Auto-merge all non-major npm and NuGet updates",
      "matchManagers": ["npm", "nuget"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true,
      "automergeType": "pr"
    }
  ]
}
